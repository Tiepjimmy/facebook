generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["facebook", "tiktok"]
}


model User {
  id          BigInt   @id @default(autoincrement())
  email       String   @unique
  password    String
  role        String
  startDate DateTime?
  endDate DateTime?
  status      Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  subscriptions UserSubscription[]
  configs       FbOverrideConfig[]
  logs UserLog[]
  @@map("User")
  @@schema("facebook")
}

model UserLog {
   id BigInt @id @default(autoincrement())

    userId BigInt

    oldStartDate DateTime?
    oldEndDate DateTime?

    newStartDate DateTime?
    newEndDate DateTime?

    note String?

    createdAt DateTime @default(now())

    user  User @relation(fields: [userId], references: [id])

    @@map("UserLog")
    @@schema("facebook")
}

model Plan {
  id            BigInt @id @default(autoincrement())

  name          String
  durationDays  Int
  price         BigInt
  createdAt     DateTime @default(now())
  subscriptions UserSubscription[]
  @@map("Plan")
  @@schema("facebook")
}

model UserSubscription {
  id          BigInt @id @default(autoincrement())
  userId      BigInt
  planId      BigInt
  startDate   DateTime
  endDate     DateTime
  status      Boolean @default(true)
  createdAt   DateTime @default(now())
  user        User @relation(fields: [userId], references: [id])
  plan        Plan @relation(fields: [planId], references: [id])

  @@map("UserSubscription")
  @@schema("facebook")
}

model FbOverrideConfig {
  id              BigInt @id @default(autoincrement())
  userId          BigInt
  rowIndex        Int
  clickValue      Int
  pricePerClick   BigInt
  isActive        Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User @relation(fields: [userId], references: [id])
  @@map("FbOverrideConfig")
  @@schema("facebook")
}
